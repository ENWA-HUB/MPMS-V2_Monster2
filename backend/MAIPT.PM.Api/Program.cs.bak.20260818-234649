    var p=await db.Projects.FindAsync(id); if(p is null)return Results.NotFound();
    await db.PerformanceItems.Where(x=>x.ProjectId==id).ExecuteUpdateAsync(x=>x.SetProperty(v=>v.ProjectId,(long?)null));
    await db.BudgetPlanItems.Where(x=>x.ProjectId==id).ExecuteUpdateAsync(x=>x.SetProperty(v=>v.ProjectId,(long?)null));
    await db.Tasks.Where(x=>x.ProjectId==id).ExecuteUpdateAsync(x=>x.SetProperty(v=>v.ParentTaskId,(long?)null).SetProperty(v=>v.MilestoneId,(long?)null));
    await db.Issues.Where(x=>x.ProjectId==id).ExecuteDeleteAsync();
    await db.Tasks.Where(x=>x.ProjectId==id).ExecuteDeleteAsync();
    var contractIds=await db.Contracts.Where(x=>x.ProjectId==id).Select(x=>x.Id).ToListAsync();
    if(contractIds.Count>0){await db.Deliverables.Where(x=>contractIds.Contains(x.ContractId)).ExecuteDeleteAsync(); await db.Contracts.Where(x=>x.ProjectId==id).ExecuteDeleteAsync();}
    var evalIds=await db.SupplierEvaluations.Where(x=>x.ProjectId==id).Select(x=>x.Id).ToListAsync();
    if(evalIds.Count>0){await db.KpiScores.Where(x=>evalIds.Contains(x.EvaluationId)).ExecuteDeleteAsync(); await db.SupplierEvaluations.Where(x=>x.ProjectId==id).ExecuteDeleteAsync();}
    var budgetIds=await db.BudgetLines.Where(x=>x.ProjectId==id).Select(x=>x.Id).ToListAsync();
    if(budgetIds.Count>0){await db.BudgetTransactions.Where(x=>budgetIds.Contains(x.BudgetLineId)).ExecuteDeleteAsync(); await db.BudgetLines.Where(x=>x.ProjectId==id).ExecuteDeleteAsync();}
    await db.Risks.Where(x=>x.ProjectId==id).ExecuteDeleteAsync();
    await db.Milestones.Where(x=>x.ProjectId==id).ExecuteDeleteAsync();
    await db.ProjectMembers.Where(x=>x.ProjectId==id).ExecuteDeleteAsync();
    await db.ChangeRequests.Where(x=>x.ProjectId==id).ExecuteDeleteAsync();
    var approvalIds=await db.ApprovalRequests.Where(x=>x.ProjectId==id).Select(x=>x.Id).ToListAsync();
    if(approvalIds.Count>0){await db.ApprovalSteps.Where(x=>approvalIds.Contains(x.ApprovalRequestId)).ExecuteDeleteAsync(); await db.ApprovalRequests.Where(x=>x.ProjectId==id).ExecuteDeleteAsync();}
    await db.Documents.Where(x=>x.EntityType=="PROJECT" && x.EntityId==id).ExecuteDeleteAsync();
